<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯: 돌아가는 카세트 + 워크맨 건반 (play) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg">
    <!-- 카세트 그림과 릴 그림은 같은 비율(16:10)이라 fitCenter로 겹치면 위치가 정확히 맞는다 -->
    <FrameLayout android:id="@+id/w_tape_area" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/w_tape" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="지금 재생 중인 카세트" />
        <!-- 재생 중: 릴 그림 6장을 번갈아 보여 돌린다 (위젯은 애니메이션을 직접 못 해서) -->
        <ViewFlipper android:id="@+id/w_reels" android:layout_width="match_parent" android:layout_height="match_parent"
            android:autoStart="true" android:flipInterval="70">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_reels_0" android:importantForAccessibility="no" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_reels_1" android:importantForAccessibility="no" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_reels_2" android:importantForAccessibility="no" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_reels_3" android:importantForAccessibility="no" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_reels_4" android:importantForAccessibility="no" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_reels_5" android:importantForAccessibility="no" />
        </ViewFlipper>
    </FrameLayout>
    <include layout="@layout/widget_keys" />
</LinearLayout>

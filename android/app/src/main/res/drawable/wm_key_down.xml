<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape><solid android:color="#FF0B0A09" /><corners android:radius="6dp" /></shape>
    </item>
    <!-- 눌리면 윗면이 내려가고 조금 어두워진다 -->
    <item android:top="3dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="270" android:startColor="#FFC9C5BD" android:centerColor="#FFB3AEA5" android:endColor="#FF9C978E" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#FF77736C" />
        </shape>
    </item>
    <item android:bottom="6dp" android:left="10dp" android:right="10dp" android:gravity="bottom" android:height="1dp">
        <shape><solid android:color="#55000000" /></shape>
    </item>
</layer-list>
